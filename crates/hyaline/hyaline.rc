// Windows resources for hyaline.exe. VERSION_* and VERSION_STR come from build.rs (Cargo.toml).
#include <winver.h>

1 ICON "../../assets/logo.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION  VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Hyaline"
            VALUE "ProductName", "Hyaline"
            VALUE "FileVersion", VERSION_STR
            VALUE "ProductVersion", VERSION_STR
            VALUE "OriginalFilename", "hyaline.exe"
            VALUE "LegalCopyright", "Copyright (c) 2026 A. Mestra. MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
